<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Form view for vd.migration.wizard.
        Placeholder — full UI is built in M5 after all fields (M2)
        and services (M3/M4) are implemented.
    -->
    <record id="view_vd_migration_wizard_form" model="ir.ui.view">
        <field name="name">vd.migration.wizard.form</field>
        <field name="model">vd.migration.wizard</field>
        <field name="arch" type="xml">
            <form string="Міграція даних">
                <sheet>
                    <div class="o_form_sheet_title">
                        <h2>VD Data Migration</h2>
                    </div>
                    <p class="text-muted">
                        Повний інтерфейс візарда буде додано в Milestone 2–5.
                    </p>
                </sheet>
                <footer>
                    <button string="Закрити" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
